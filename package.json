{
  "name": "fem-backend",
  "version": "0.1.0",
  "description": "Backend foundation for the National Equestrian Federation of Moldova information platform",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"*.json\" \"*.yml\" \"*.yaml\" \"*.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand --detectOpenHandles",
    "test:db": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --config ./test/jest-db.json --runInBand",
    "test:performance": "tsx scripts/performance-audit.ts",
    "test:runtime-role": "pnpm build && tsx scripts/runtime-role-smoke.ts",
    "openapi:export": "node --env-file-if-exists=.env -r ts-node/register scripts/export-openapi.ts",
    "openapi:check": "node --env-file-if-exists=.env -r ts-node/register scripts/export-openapi.ts --check",
    "openapi:types": "tsx scripts/generate-openapi-types.ts",
    "openapi:types:check": "tsx scripts/generate-openapi-types.ts --check",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "web:dev": "pnpm --dir apps/demo-web dev",
    "web:preview": "pnpm --dir apps/demo-web preview",
    "web:format": "pnpm --dir apps/demo-web format",
    "web:lint": "pnpm --dir apps/demo-web lint",
    "web:typecheck": "pnpm --dir apps/demo-web typecheck",
    "web:test": "pnpm --dir apps/demo-web test",
    "web:build": "pnpm --dir apps/demo-web build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "4.6.1",
    "otplib": "^12.0.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "jest": "29.7.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
