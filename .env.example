# Copy this file to .env and replace every change_me value.
NODE_ENV=development
PORT=3000
API_PREFIX=api
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTH_ENCRYPTION_KEY=change_me_to_64_hex_characters
AUTH_COOKIE_NAME=fem_admin_session
AUTH_SESSION_TTL_MINUTES=480
AUTH_SESSION_IDLE_MINUTES=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Enable only after HTTPS termination and all covered subdomains are verified.
HSTS_ENABLED=false
# Exact number of trusted reverse proxies between the client and NestJS.
TRUST_PROXY_HOPS=0
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_ADMIN_PER_MINUTE=300
RATE_LIMIT_PUBLIC_PER_MINUTE=600
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_FILES_PER_MINUTE=60
RATE_LIMIT_INTEGRATIONS_PER_MINUTE=300
SWAGGER_ENABLED=true
# Required when SWAGGER_ENABLED=true in production.
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# One-time administrator bootstrap. Keep false during normal application use.
ALLOW_ADMIN_BOOTSTRAP=false
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_DISPLAY_NAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_TOTP_SECRET=

POSTGRES_DB=equestrian_federation
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:change_me_local_only@localhost:5432/equestrian_federation?schema=public

# Required only in the shell/process that intentionally runs the fictional demo seed.
ALLOW_DEMO_SEED=false
