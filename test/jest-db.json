{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/**/*.db-spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/test/setup/assert-safe-test-database.ts"],
  "testEnvironment": "node",
  "testTimeout": 30000
}
