generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  CONFLICT
  REJECTED
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum ImportRowStatus {
  PENDING
  VALIDATED
  IMPORTED
  SKIPPED
  CONFLICT
  FAILED
}

enum RankingSubjectType {
  ATHLETE
  HORSE
  ATHLETE_HORSE_PAIR
}

enum RankingCalculationStatus {
  DRAFT
  PREPARING
  FROZEN
  FAILED
  SUPERSEDED
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  email                      String               @unique
  displayName                String
  status                     RecordStatus         @default(ACTIVE)
  isDemo                     Boolean              @default(false)
  archivedAt                 DateTime?            @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(3)
  userRoles                  UserRole[]           @relation("UserRoleUser")
  assignedUserRoles          UserRole[]           @relation("UserRoleAssigner")
  credential                 UserCredential?
  adminSessions              AdminSession[]
  recoveryCodes              AdminRecoveryCode[]
  idempotencyRecords         IdempotencyRecord[]
  auditLogs                  AuditLog[]
  importBatches              ImportBatch[]
  verifiedIdentifiers        ExternalIdentifier[]
  approvedCompetitionResults CompetitionResult[]
  approvedRankingRuleSets    RankingRuleSet[]
  createdRankingSnapshots    RankingSnapshot[]

  @@index([status, archivedAt])
}

model UserCredential {
  userId              String    @id @db.Uuid
  passwordHash        String
  totpSecretEncrypted String
  twoFactorEnabledAt  DateTime  @db.Timestamptz(3)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(3)
  passwordChangedAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastTotpStep        BigInt?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([lockedUntil])
}

model AdminSession {
  id                         String              @id @default(uuid()) @db.Uuid
  userId                     String              @db.Uuid
  tokenHash                  String              @unique @db.Char(64)
  previousTokenHash          String?             @unique @db.Char(64)
  previousTokenExpiresAt     DateTime?           @db.Timestamptz(3)
  csrfTokenHash              String              @db.Char(64)
  secondFactorMethod         String              @default("TOTP") @db.VarChar(16)
  tokenRotatedAt             DateTime?           @db.Timestamptz(3)
  pendingTotpSecretEncrypted String?
  pendingTotpExpiresAt       DateTime?           @db.Timestamptz(3)
  expiresAt                  DateTime            @db.Timestamptz(3)
  idleExpiresAt              DateTime            @db.Timestamptz(3)
  lastSeenAt                 DateTime            @default(now()) @db.Timestamptz(3)
  revokedAt                  DateTime?           @db.Timestamptz(3)
  revokeReason               String?             @db.VarChar(200)
  ipAddress                  String?             @db.VarChar(64)
  userAgent                  String?             @db.VarChar(512)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(3)
  user                       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  auditLogs                  AuditLog[]
  idempotencyRecords         IdempotencyRecord[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([idleExpiresAt])
}

model AdminRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique @db.Char(64)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, usedAt])
}

model RateLimitBucket {
  key             String    @id @db.VarChar(200)
  throttlerName   String    @db.VarChar(50)
  windowStartedAt DateTime  @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  totalHits       Int
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([blockedUntil])
}

model IdempotencyRecord {
  id             String       @id @db.Char(64)
  actorId        String       @db.Uuid
  sessionId      String       @db.Uuid
  key            String       @db.VarChar(128)
  method         String       @db.VarChar(10)
  path           String       @db.VarChar(500)
  requestHash    String       @db.Char(64)
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime     @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  session        AdminSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  description String?
  isSystem    Boolean    @default(false)
  isDemo      Boolean    @default(false)
  archivedAt  DateTime?  @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  userRoles   UserRole[]
}

model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  assignedById String?   @db.Uuid
  isDemo       Boolean   @default(false)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  user         User      @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId, startDate, endDate])
  @@index([roleId, endDate])
}

model AuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  actorId    String?       @db.Uuid
  action     String
  entityType String
  entityId   String        @db.Uuid
  oldData    Json?
  newData    Json?
  reason     String?
  requestId  String?
  sessionId  String?       @db.Uuid
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  actor      User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  session    AdminSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([sessionId, createdAt(sort: Desc)])
}

model ImportBatch {
  id          String            @id @default(uuid()) @db.Uuid
  entityType  String
  sourceType  String
  filename    String
  checksum    String
  status      ImportBatchStatus @default(PENDING)
  totalRows   Int               @default(0)
  successRows Int               @default(0)
  failedRows  Int               @default(0)
  createdById String?           @db.Uuid
  isDemo      Boolean           @default(false)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  completedAt DateTime?         @db.Timestamptz(3)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rows        ImportRow[]

  @@index([status, createdAt(sort: Desc)])
  @@index([checksum, sourceType, entityType, createdAt(sort: Desc)])
}

model ImportRow {
  id               String          @id @default(uuid()) @db.Uuid
  importBatchId    String          @db.Uuid
  rowNumber        Int
  rawData          Json
  normalizedData   Json?
  status           ImportRowStatus @default(PENDING)
  errorMessage     String?
  linkedEntityType String?
  linkedEntityId   String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  importBatch      ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status, rowNumber])
  @@index([linkedEntityType, linkedEntityId])
}

model MediaFile {
  id           String             @id @default(uuid()) @db.Uuid
  storageKey   String             @unique
  filename     String
  mimeType     String
  sizeBytes    BigInt
  checksum     String?
  altText      String?
  credit       String?
  status       RecordStatus       @default(DRAFT)
  isDemo       Boolean            @default(false)
  archivedAt   DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  documents    Document[]
  athletes     Athlete[]
  horses       Horse[]
  competitions CompetitionEvent[]

  @@index([checksum])
}

model Document {
  id                    String                  @id @default(uuid()) @db.Uuid
  title                 String
  documentType          String?
  mediaFileId           String?                 @db.Uuid
  sourceUrl             String?
  issuedAt              DateTime?               @db.Date
  publicationStatus     PublicationStatus       @default(DRAFT)
  isDemo                Boolean                 @default(false)
  archivedAt            DateTime?               @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  mediaFile             MediaFile?              @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  externalIdentifiers   ExternalIdentifier[]
  clubMemberships       AthleteClubMembership[]
  athleteHorseRelations AthleteHorseRelation[]
  horseOwnerships       HorseOwnership[]
  competitionResults    CompetitionResult[]
  rankingRuleSets       RankingRuleSet[]

  @@index([publicationStatus, archivedAt, createdAt(sort: Desc)])
  @@index([mediaFileId])
}

model ExternalIdentifier {
  id                   String             @id @default(uuid()) @db.Uuid
  version              Int                @default(1)
  entityType           String
  entityId             String             @db.Uuid
  identifierType       String
  namespace            String
  value                String
  normalizedValue      String
  normalizationVersion String
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  isPrimary            Boolean            @default(false)
  validFrom            DateTime?          @db.Date
  validTo              DateTime?          @db.Date
  sourceDocumentId     String?            @db.Uuid
  sourceReference      String?
  verifiedById         String?            @db.Uuid
  verifiedAt           DateTime?          @db.Timestamptz(3)
  isDemo               Boolean            @default(false)
  archivedAt           DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  sourceDocument       Document?          @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  verifiedBy           User?              @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([namespace, identifierType, normalizedValue])
  @@index([entityType, entityId, archivedAt])
  @@index([identifierType, normalizedValue])
  @@index([verificationStatus, archivedAt, createdAt])
  @@index([sourceDocumentId])
  @@index([verifiedById])
}

model Country {
  id                  String               @id @default(uuid()) @db.Uuid
  version             Int                  @default(1)
  isoAlpha2           String               @unique @db.Char(2)
  isoAlpha3           String               @unique @db.Char(3)
  name                String
  isDemo              Boolean              @default(false)
  archivedAt          DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  nationalFederations NationalFederation[]
  clubs               Club[]
  athletes            Athlete[]
  horses              Horse[]
  owners              Owner[]
  competitions        CompetitionEvent[]
}

model NationalFederation {
  id         String       @id @default(uuid()) @db.Uuid
  countryId  String       @db.Uuid
  name       String
  shortName  String?
  websiteUrl String?
  status     RecordStatus @default(DRAFT)
  isDemo     Boolean      @default(false)
  archivedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  country    Country      @relation(fields: [countryId], references: [id], onDelete: Restrict)
  clubs      Club[]
  athletes   Athlete[]

  @@index([countryId, archivedAt])
}

model Discipline {
  id                    String                 @id @default(uuid()) @db.Uuid
  version               Int                    @default(1)
  code                  String                 @unique
  name                  String
  description           String?
  status                RecordStatus           @default(DRAFT)
  isDemo                Boolean                @default(false)
  archivedAt            DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  athleteHorseRelations AthleteHorseRelation[]
  competitionClasses    CompetitionClass[]
  rankingDefinitions    RankingDefinition[]
}

model Club {
  id                   String                  @id @default(uuid()) @db.Uuid
  version              Int                     @default(1)
  name                 String
  legalName            String?
  countryId            String?                 @db.Uuid
  nationalFederationId String?                 @db.Uuid
  status               RecordStatus            @default(DRAFT)
  isDemo               Boolean                 @default(false)
  archivedAt           DateTime?               @db.Timestamptz(3)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  country              Country?                @relation(fields: [countryId], references: [id], onDelete: Restrict)
  nationalFederation   NationalFederation?     @relation(fields: [nationalFederationId], references: [id], onDelete: Restrict)
  memberships          AthleteClubMembership[]

  @@index([name, id])
  @@index([countryId, status, archivedAt])
  @@index([nationalFederationId, archivedAt])
}

model ResultStatus {
  id             String              @id @default(uuid()) @db.Uuid
  code           String              @unique
  label          String
  description    String?
  sortOrder      Int                 @default(0)
  isRankEligible Boolean?
  status         RecordStatus        @default(DRAFT)
  isDemo         Boolean             @default(false)
  archivedAt     DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  results        CompetitionResult[]
}

model Athlete {
  id                   String                  @id @default(uuid()) @db.Uuid
  version              Int                     @default(1)
  firstName            String
  lastName             String
  displayName          String
  dateOfBirth          DateTime?               @db.Date
  gender               String?
  countryId            String?                 @db.Uuid
  nationalFederationId String?                 @db.Uuid
  photoId              String?                 @db.Uuid
  status               RecordStatus            @default(DRAFT)
  isDemo               Boolean                 @default(false)
  archivedAt           DateTime?               @db.Timestamptz(3)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  country              Country?                @relation(fields: [countryId], references: [id], onDelete: Restrict)
  nationalFederation   NationalFederation?     @relation(fields: [nationalFederationId], references: [id], onDelete: Restrict)
  photo                MediaFile?              @relation(fields: [photoId], references: [id], onDelete: SetNull)
  clubMemberships      AthleteClubMembership[]
  horseRelations       AthleteHorseRelation[]
  competitionResults   CompetitionResult[]
  rankingEntries       RankingEntry[]

  @@index([lastName, firstName, id])
  @@index([displayName, id])
  @@index([countryId, status, archivedAt])
  @@index([nationalFederationId, archivedAt])
}

model Horse {
  id                 String                 @id @default(uuid()) @db.Uuid
  version            Int                    @default(1)
  passportName       String?
  displayName        String
  dateOfBirth        DateTime?              @db.Date
  birthYear          Int?
  sex                String?
  breed              String?
  color              String?
  countryOfBirthId   String?                @db.Uuid
  studbook           String?
  imageId            String?                @db.Uuid
  status             RecordStatus           @default(DRAFT)
  isDemo             Boolean                @default(false)
  archivedAt         DateTime?              @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  countryOfBirth     Country?               @relation(fields: [countryOfBirthId], references: [id], onDelete: Restrict)
  image              MediaFile?             @relation(fields: [imageId], references: [id], onDelete: SetNull)
  athleteRelations   AthleteHorseRelation[]
  ownerships         HorseOwnership[]
  competitionResults CompetitionResult[]
  rankingEntries     RankingEntry[]

  @@index([displayName, id])
  @@index([passportName, id])
  @@index([birthYear, displayName, id])
  @@index([countryOfBirthId, status, archivedAt])
}

model Owner {
  id          String           @id @default(uuid()) @db.Uuid
  version     Int              @default(1)
  displayName String
  ownerType   String?
  countryId   String?          @db.Uuid
  status      RecordStatus     @default(DRAFT)
  isDemo      Boolean          @default(false)
  archivedAt  DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  country     Country?         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  ownerships  HorseOwnership[]

  @@index([displayName, id])
  @@index([countryId, archivedAt])
}

model AthleteClubMembership {
  id               String    @id @default(uuid()) @db.Uuid
  version          Int       @default(1)
  athleteId        String    @db.Uuid
  clubId           String    @db.Uuid
  membershipType   String?
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  sourceDocumentId String?   @db.Uuid
  isDemo           Boolean   @default(false)
  archivedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  athlete          Athlete   @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  club             Club      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([athleteId, clubId, startDate, membershipType], map: "AthleteClubMembership_exact_key")
  @@index([athleteId, startDate(sort: Desc), endDate])
  @@index([clubId, startDate(sort: Desc), endDate])
  @@index([sourceDocumentId])
}

model AthleteHorseRelation {
  id               String      @id @default(uuid()) @db.Uuid
  version          Int         @default(1)
  athleteId        String      @db.Uuid
  horseId          String      @db.Uuid
  relationType     String?
  disciplineId     String?     @db.Uuid
  startDate        DateTime    @db.Date
  endDate          DateTime?   @db.Date
  sourceDocumentId String?     @db.Uuid
  isDemo           Boolean     @default(false)
  archivedAt       DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  athlete          Athlete     @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  horse            Horse       @relation(fields: [horseId], references: [id], onDelete: Restrict)
  discipline       Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  sourceDocument   Document?   @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([athleteId, horseId, relationType, startDate, disciplineId], map: "AthleteHorseRelation_exact_key")
  @@index([athleteId, startDate(sort: Desc), endDate])
  @@index([horseId, startDate(sort: Desc), endDate])
  @@index([disciplineId, endDate])
  @@index([sourceDocumentId])
}

model HorseOwnership {
  id               String    @id @default(uuid()) @db.Uuid
  version          Int       @default(1)
  horseId          String    @db.Uuid
  ownerId          String    @db.Uuid
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  ownershipShare   Decimal?  @db.Decimal(5, 2)
  sourceDocumentId String?   @db.Uuid
  isDemo           Boolean   @default(false)
  archivedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  horse            Horse     @relation(fields: [horseId], references: [id], onDelete: Restrict)
  owner            Owner     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([horseId, ownerId, startDate])
  @@index([horseId, startDate(sort: Desc), endDate])
  @@index([ownerId, startDate(sort: Desc), endDate])
  @@index([sourceDocumentId])
}

model CompetitionEvent {
  id                String             @id @default(uuid()) @db.Uuid
  version           Int                @default(1)
  title             String
  slug              String             @unique
  description       String?
  startDate         DateTime           @db.Date
  endDate           DateTime           @db.Date
  location          String?
  venue             String?
  countryId         String?            @db.Uuid
  organizerName     String?
  status            RecordStatus       @default(DRAFT)
  publicationStatus PublicationStatus  @default(DRAFT)
  coverMediaId      String?            @db.Uuid
  publishedAt       DateTime?          @db.Timestamptz(3)
  isDemo            Boolean            @default(false)
  archivedAt        DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  country           Country?           @relation(fields: [countryId], references: [id], onDelete: Restrict)
  coverMedia        MediaFile?         @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  classes           CompetitionClass[]

  @@index([publicationStatus, startDate(sort: Desc), id])
  @@index([countryId, startDate(sort: Desc), id])
  @@index([status, startDate(sort: Desc)])
  @@index([endDate, id])
}

model CompetitionClass {
  id                 String              @id @default(uuid()) @db.Uuid
  version            Int                 @default(1)
  competitionEventId String              @db.Uuid
  title              String
  disciplineId       String              @db.Uuid
  category           String?
  level              String?
  competitionDate    DateTime?           @db.Date
  sortOrder          Int                 @default(0)
  status             RecordStatus        @default(DRAFT)
  isDemo             Boolean             @default(false)
  archivedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  competitionEvent   CompetitionEvent    @relation(fields: [competitionEventId], references: [id], onDelete: Restrict)
  discipline         Discipline          @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  results            CompetitionResult[]

  @@index([competitionEventId, sortOrder, id])
  @@index([disciplineId, competitionDate, id])
  @@index([competitionEventId, status])
}

model CompetitionResult {
  id                  String               @id @default(uuid()) @db.Uuid
  version             Int                  @default(1)
  competitionClassId  String               @db.Uuid
  athleteId           String               @db.Uuid
  horseId             String               @db.Uuid
  rank                Int?
  statusId            String?              @db.Uuid
  resultDisplay       String?
  penalties           Decimal?             @db.Decimal(18, 6)
  timeSeconds         Decimal?             @db.Decimal(12, 3)
  points              Decimal?             @db.Decimal(18, 6)
  bonus               Decimal?             @db.Decimal(18, 6)
  sourceDocumentId    String?              @db.Uuid
  sourceReference     String?
  publicationStatus   PublicationStatus    @default(DRAFT)
  publishedAt         DateTime?            @db.Timestamptz(3)
  approvedAt          DateTime?            @db.Timestamptz(3)
  approvedById        String?              @db.Uuid
  isDemo              Boolean              @default(false)
  archivedAt          DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  competitionClass    CompetitionClass     @relation(fields: [competitionClassId], references: [id], onDelete: Restrict)
  athlete             Athlete              @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  horse               Horse                @relation(fields: [horseId], references: [id], onDelete: Restrict)
  status              ResultStatus?        @relation(fields: [statusId], references: [id], onDelete: Restrict)
  sourceDocument      Document?            @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  approvedBy          User?                @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  metrics             ResultMetric[]
  rankingEntryResults RankingEntryResult[]

  @@index([competitionClassId, publicationStatus, rank, id])
  @@index([athleteId, publicationStatus, createdAt(sort: Desc), id])
  @@index([horseId, publicationStatus, createdAt(sort: Desc), id])
  @@index([statusId, publicationStatus])
  @@index([sourceDocumentId])
  @@index([approvedById])
}

model ResultMetric {
  id                  String            @id @default(uuid()) @db.Uuid
  version             Int               @default(1)
  competitionResultId String            @db.Uuid
  metricCode          String
  numericValue        Decimal?          @db.Decimal(18, 6)
  textValue           String?
  unit                String?
  sortOrder           Int               @default(0)
  isDemo              Boolean           @default(false)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  competitionResult   CompetitionResult @relation(fields: [competitionResultId], references: [id], onDelete: Restrict)

  @@unique([competitionResultId, metricCode, sortOrder])
  @@index([competitionResultId, sortOrder, id])
}

model RankingDefinition {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique
  name         String
  description  String?
  disciplineId String?            @db.Uuid
  subjectType  RankingSubjectType
  status       RecordStatus       @default(DRAFT)
  isDemo       Boolean            @default(false)
  archivedAt   DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  discipline   Discipline?        @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  ruleSets     RankingRuleSet[]
  periods      RankingPeriod[]

  @@index([disciplineId, subjectType, status, archivedAt])
}

model RankingRuleSet {
  id                         String            @id @default(uuid()) @db.Uuid
  rankingDefinitionId        String            @db.Uuid
  version                    Int
  name                       String
  calculationMethod          String?
  configuration              Json?
  configurationSchemaVersion String?
  engineVersion              String?
  status                     RecordStatus      @default(DRAFT)
  effectiveFrom              DateTime?         @db.Date
  effectiveTo                DateTime?         @db.Date
  sourceDocumentId           String?           @db.Uuid
  sourceReference            String?
  approvedAt                 DateTime?         @db.Timestamptz(3)
  approvedById               String?           @db.Uuid
  isDemo                     Boolean           @default(false)
  archivedAt                 DateTime?         @db.Timestamptz(3)
  createdAt                  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(3)
  rankingDefinition          RankingDefinition @relation(fields: [rankingDefinitionId], references: [id], onDelete: Restrict)
  sourceDocument             Document?         @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  approvedBy                 User?             @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  snapshots                  RankingSnapshot[]

  @@unique([rankingDefinitionId, version])
  @@index([rankingDefinitionId, status, archivedAt])
  @@index([sourceDocumentId])
  @@index([approvedById])
}

model RankingPeriod {
  id                  String            @id @default(uuid()) @db.Uuid
  rankingDefinitionId String            @db.Uuid
  code                String
  label               String
  startDate           DateTime?         @db.Date
  endDate             DateTime?         @db.Date
  status              RecordStatus      @default(DRAFT)
  isDemo              Boolean           @default(false)
  archivedAt          DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  rankingDefinition   RankingDefinition @relation(fields: [rankingDefinitionId], references: [id], onDelete: Restrict)
  snapshots           RankingSnapshot[]

  @@unique([rankingDefinitionId, code])
  @@index([rankingDefinitionId, startDate, endDate])
  @@index([status, archivedAt])
}

model RankingSnapshot {
  id                    String                   @id @default(uuid()) @db.Uuid
  rankingPeriodId       String                   @db.Uuid
  rankingRuleSetId      String?                  @db.Uuid
  revision              Int
  snapshotAt            DateTime                 @db.Timestamptz(3)
  calculationMethod     String?
  calculationStatus     RankingCalculationStatus @default(DRAFT)
  publicationStatus     PublicationStatus        @default(DRAFT)
  calculatedAt          DateTime?                @db.Timestamptz(3)
  publishedAt           DateTime?                @db.Timestamptz(3)
  createdById           String?                  @db.Uuid
  supersedesSnapshotId  String?                  @db.Uuid
  comparisonSnapshotId  String?                  @db.Uuid
  notes                 String?
  isDemo                Boolean                  @default(false)
  archivedAt            DateTime?                @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  rankingPeriod         RankingPeriod            @relation(fields: [rankingPeriodId], references: [id], onDelete: Restrict)
  rankingRuleSet        RankingRuleSet?          @relation(fields: [rankingRuleSetId], references: [id], onDelete: Restrict)
  createdBy             User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  supersedesSnapshot    RankingSnapshot?         @relation("SnapshotSupersession", fields: [supersedesSnapshotId], references: [id], onDelete: Restrict)
  supersededBySnapshots RankingSnapshot[]        @relation("SnapshotSupersession")
  comparisonSnapshot    RankingSnapshot?         @relation("SnapshotComparison", fields: [comparisonSnapshotId], references: [id], onDelete: Restrict)
  comparedBySnapshots   RankingSnapshot[]        @relation("SnapshotComparison")
  entries               RankingEntry[]

  @@unique([rankingPeriodId, revision])
  @@index([rankingPeriodId, publicationStatus, snapshotAt(sort: Desc), revision(sort: Desc)])
  @@index([calculationStatus, createdAt])
  @@index([rankingRuleSetId])
  @@index([createdById])
  @@index([supersedesSnapshotId])
  @@index([comparisonSnapshotId])
}

model RankingEntry {
  id                 String               @id @default(uuid()) @db.Uuid
  rankingSnapshotId  String               @db.Uuid
  subjectType        RankingSubjectType
  athleteId          String?              @db.Uuid
  horseId            String?              @db.Uuid
  rank               Int?
  previousRank       Int?
  points             Decimal?             @db.Decimal(20, 6)
  countedResultCount Int                  @default(0)
  droppedResultCount Int                  @default(0)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  rankingSnapshot    RankingSnapshot      @relation(fields: [rankingSnapshotId], references: [id], onDelete: Restrict)
  athlete            Athlete?             @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  horse              Horse?               @relation(fields: [horseId], references: [id], onDelete: Restrict)
  sourceResults      RankingEntryResult[]

  @@index([rankingSnapshotId, rank, id])
  @@index([athleteId, rankingSnapshotId])
  @@index([horseId, rankingSnapshotId])
}

model RankingEntryResult {
  id                  String            @id @default(uuid()) @db.Uuid
  rankingEntryId      String            @db.Uuid
  competitionResultId String            @db.Uuid
  isCounted           Boolean
  pointsContribution  Decimal?          @db.Decimal(20, 6)
  decisionReason      String?
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  rankingEntry        RankingEntry      @relation(fields: [rankingEntryId], references: [id], onDelete: Restrict)
  competitionResult   CompetitionResult @relation(fields: [competitionResultId], references: [id], onDelete: Restrict)

  @@unique([rankingEntryId, competitionResultId])
  @@index([rankingEntryId, isCounted, sortOrder, id])
  @@index([competitionResultId])
}
