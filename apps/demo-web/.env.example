# Optional in local development. Production defaults to the same-origin /api/v1 proxy.
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1

# Vercel runtime secret for apps/demo-web/api/v1/[...path].ts.
# Set it only in the frontend Vercel Project, without a trailing slash.
FEM_BACKEND_ORIGIN=https://your-fem-api.vercel.app
